# ==============================================================================
# FloodIntel — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env.local' and provide your actual API keys.
# DO NOT commit '.env.local' or your actual API credentials to version control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenWeatherMap API (Telemetry & Rainfall Forecasts)
# Obtain an API key from: https://openweathermap.org/api
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Mapbox / OpenStreetMap (Spatial Tiles & Routing Engine)
# Required for interactive map displays and vector tiles
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Google Gemini API (Natural Language Advisory & Explainable Flood Risk Insights)
# Obtain an API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Public Demo Mode toggle
# Set to 'true' to display clear demo disclaimers and synthesized telemetry
NEXT_PUBLIC_DEMO_MODE=true
