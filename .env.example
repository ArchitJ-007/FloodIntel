# ==============================================================================
# FloodIntel — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env.local' and provide your actual API keys.
# DO NOT commit '.env.local' or your actual API credentials to version control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Weather Telemetry Provider: Open-Meteo
# Note: Open-Meteo's standard forecast API is accessed server-side via /api/weather
# and requires NO API KEY for standard non-commercial usage.

# CARTO Basemap API Key (Raster & Vector Map Tiles)
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# Google Gemini API (Natural Language Advisory & Risk Explanations — Phase 5)
# Obtain an API key from: https://aistudio.google.com/
# (Server-side secret, do NOT prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here

# Public Demo Mode toggle
# Set to 'true' to display clear demo disclaimers and synthetic test incident indicators
NEXT_PUBLIC_DEMO_MODE=true

# Mappls / MapmyIndia Geocoding & AutoSuggest API (Optional)
# If provided, server-side /api/places/search will query Mappls AutoSuggest for nationwide Indian locations.
# If omitted or unconfigured, the system automatically falls back to Open-Meteo Geocoding API + curated urban flood landmarks.
# (Server-side secret, do NOT prefix with NEXT_PUBLIC_)
MAPPLS_API_KEY=your_mappls_api_key_here
